{
  "version": "0.1",
  "updated": "2026-05-05",
  "purpose": "Synthetic Browser/E2E text fixtures for validating model-based staging analysis before real staging access is connected.",
  "rules": [
    "fixtures are synthetic by default",
    "do not include real personal data",
    "do not include real staging URLs",
    "do not include secrets, cookies, tokens, credentials, or session dumps",
    "real staging runs must use sanitized text summaries unless explicitly approved",
    "model output must be strict JSON matching the report schema",
    "fixture smoke success does not mean browser automation is complete"
  ],
  "report_schema": {
    "passed": "boolean",
    "score": "number from 0 to 1",
    "summary": "string",
    "matched_criteria": [
      "string"
    ],
    "missing_criteria": [
      "string"
    ],
    "issues": [
      {
        "severity": "low | medium | high",
        "description": "string",
        "evidence": "string"
      }
    ],
    "recommendation": "string"
  },
  "fixtures": {
