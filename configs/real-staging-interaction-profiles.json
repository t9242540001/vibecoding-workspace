  "profiles": [
    {
      "profile_id": "homepage-load-only",
      "route_compatibility": [
        "yurassistent-home"
      ],
      "purpose": "Verify that the public homepage loads and produces a safe sanitized summary.",
      "allowed_actions": [
        "navigate_to_route",
        "wait_for_page_load",
        "collect_sanitized_visible_text",
        "collect_high_level_console_errors",
        "collect_high_level_network_errors"
      ],
      "forbidden_actions": [
        "click",
        "type",
        "submit_form",
        "upload_file",
        "login",
        "payment",
        "account_creation",
        "screenshot",
        "video",
        "trace",
        "raw_har"
      ],
      "acceptance_criteria": [
        "page loads successfully",
        "page title or visible text is present",
        "visible text is not empty",
        "no high-level console errors are present",
        "no high-level network errors are present",
        "sanitized summary contains no forbidden artifacts"
      ]
    },
    {
