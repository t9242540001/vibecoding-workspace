        "rules": [
          "do not click the CTA",
          "do not follow links",
          "do not submit forms",
          "do not infer from screenshots"
        ],
        "acceptable_cta_text_candidates": [
          "Начать",
          "Начать бесплатно",
          "Попробовать",
          "Создать документ",
          "Получить консультацию",
          "Запустить",
          "Открыть помощника"
        ]
      },
      "acceptance_criteria": [
        "page loads successfully",
        "visible text is not empty",
        "primary CTA candidate is present in sanitized visible text",
        "no high-level console errors are present",
        "no high-level network errors are present",
        "sanitized summary contains no forbidden artifacts"
      ]
    },
