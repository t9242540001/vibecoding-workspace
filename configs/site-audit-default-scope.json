{
  "version": "1.0",
  "updated": "2026-05-22",
  "purpose": "Universal default scope policy for safe Vibe Coding site audits.",
  "audit_modes": [
    {
      "mode": "static_repository_audit",
      "description": "Inspect approved repository files, public configuration, source, tests, content, and metadata without live browser evidence.",
      "requires_separate_approval": false
    },
    {
      "mode": "read_only_live_public_audit",
      "description": "Observe approved public no-auth pages and supplied sanitized browser summaries without submitting data or changing state.",
      "requires_separate_approval": true
    },
    {
      "mode": "non_submit_form_tool_audit",
      "description": "Inspect fields, labels, hints, states, and client-side validation without submitting data.",
      "requires_separate_approval": true
    },
    {
      "mode": "approved_submit_auth_payment_admin_audit",
      "description": "Perform a specifically approved submit, auth, payment, admin, account, upload, or state-changing flow.",
      "requires_separate_approval": true
    },
    {
      "mode": "post_fix_regression_audit",
      "description": "Retest prior finding IDs and acceptance criteria after approved fixes.",
      "requires_separate_approval": false
    }
  ],
  "default_forbidden_actions": [
    "arbitrary_urls",
    "arbitrary_browser_commands",
    "broad_crawling",
    "scraping",
    "rate_heavy_checks",
    "production_form_submit",
    "contact_message_sending",
    "login",
    "logout",
    "auth_flow",
    "admin_flow",
    "billing_flow",
    "payment_flow",
    "account_creation",
    "account_settings_change",
    "file_upload",
    "destructive_action",
    "real_personal_data_use",
    "real_client_data_use",
    "payment_data_use",
    "credential_use",
    "deploy_action",
    "server_action",
    "database_action",
    "secrets_action",
    "ssh",
    "scp",
    "dependency_installation",
    "product_code_change_during_audit"
  ],
  "default_allowed_read_only_actions": [
    "read_approved_repository_files",
    "read_project_instructions_and_knowledge",
    "inspect_public_no_auth_pages_in_scope",
    "inspect_visible_text",
    "inspect_public_metadata",
    "inspect_public_page_source_when_in_scope",
    "review_supplied_sanitized_browser_summaries",
    "review_high_level_console_error_summaries",
    "review_high_level_network_error_summaries",
    "classify_public_links_without_opening_private_or_action_links",
    "run_repo_local_validation_commands_in_scope",
    "run_report_validation_checks"
  ],
  "default_audit_dimensions": [
    "technical_frontend_health",
    "ux_usability",
    "accessibility",
    "responsive_mobile",
    "forms_tools",
    "seo",
    "aeo_geo_ai_friendly_content",
    "copy_grammar_trust_legal_risk_wording",
    "design_visual_consistency",
    "analytics_conversion",
    "public_ui_security_privacy"
  ],
  "default_viewports": [
    {
      "label": "desktop_default",
      "width": 1440,
      "height": 900,
      "required_by_default": true
    },
    {
      "label": "mobile_320",
      "width": 320,
      "height": 720,
      "required_by_default": false
    },
    {
      "label": "mobile_360",
      "width": 360,
      "height": 800,
      "required_by_default": true
    },
    {
      "label": "mobile_390",
      "width": 390,
      "height": 844,
      "required_by_default": true
    },
    {
      "label": "mobile_414",
      "width": 414,
      "height": 896,
      "required_by_default": false
    },
    {
      "label": "tablet_768",
      "width": 768,
      "height": 1024,
      "required_by_default": false
    }
  ],
  "default_stop_conditions": [
    "secret_or_credential_exposure",
    "token_cookie_auth_header_or_session_material_seen",
    "real_personal_client_or_payment_data_seen",
    "unapproved_submit_auth_payment_admin_account_upload_or_destructive_action_required",
    "private_url_private_endpoint_or_account_boundary_encountered",
    "server_deploy_database_secrets_ssh_scp_or_production_config_action_needed",
    "evidence_source_outside_approved_artifact_policy",
    "broad_crawling_scraping_rate_heavy_or_anti_abuse_risk",
    "raw_browser_session_artifact_required_without_approval",
    "validation_failure_outside_current_scope",
    "ambiguous_scope_with_material_safety_or_semantic_risk"
  ],
  "default_artifact_policy": {
    "allowed_by_default": [
      "audit_report_markdown",
      "sanitized_summary_json",
      "validation_report_json",
      "short_markdown_summary",
      "source_line_references",
      "command_output_excerpts_without_secrets",
      "high_level_console_error_summaries",
      "high_level_network_error_summaries"
    ],
    "forbidden_by_default": [
      "screenshots",
      "videos",
      "traces",
      "raw_har",
      "cookies",
      "local_storage",
      "session_storage",
      "storage_state",
      "auth_headers",
      "bearer_tokens",
      "api_keys",
      "passwords",
      "session_dumps",
      "raw_request_bodies",
      "raw_response_bodies",
      "real_personal_data",
      "private_client_data",
      "billing_payment_data",
      "full_private_urls",
      "server_ips",
      "private_endpoints",
      "local_file_paths"
    ],
    "default_retention_days": 3,
    "screenshots_videos_traces_raw_har_policy": "requires_separate_explicit_approval"
  },
  "report_required_sections": [
    "summary",
    "scope",
    "method",
    "evidence_inventory",
    "findings",
    "severity_definitions",
    "prioritized_recommendations",
    "safe_boundary_notes",
    "stop_conditions",
    "next_fix_prompts"
  ],
  "rules": [
    "defaults are universal and must be narrowed by product-specific scope",
    "do not include product-specific URLs in this config",
    "read-only audit, non-submit inspection, and submit/action flows are separate modes",
    "model analysis may receive only sanitized summaries, acceptance criteria, and report schema unless separately approved",
    "audit work observes and reports; fixes require separate scoped approval"
  ]
}
